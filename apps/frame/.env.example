# Keep this file private after copying it to .env.
# Obtain a Gemini key privately from your account owner or Google AI Studio:
# https://aistudio.google.com/apikey
# Standard and authorization keys are accepted; model listing does not test video polling.
# For an interaction authentication conflict, see README.md before retrying.
GEMINI_API_KEY=
# Optional: a local folder for application state (default: OS application data).
# FRAME_DATA_DIR=
# Optional: default folder for new task media.
# FRAME_OUTPUT_DIR=
PORT=4310
