{
  "name": "frame-video-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "frame": "scripts/frame.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node scripts/service.js start",
    "stop": "node scripts/service.js stop",
    "serve": "node server/index.js",
    "cli": "node scripts/frame.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "format": "prettier --write client/src server scripts tests *.js docs README.md package.json"
  },
  "dependencies": {
    "@fontsource/newsreader": "^5.2.8",
    "@fontsource/source-sans-3": "^5.2.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "vite": "^7.1.0"
  }
}
